              "mode": "raw",
              "raw": "{\n  \"customerId\": \"cc000000-0000-4000-a000-000000000001\",\n  \"carId\": \"{{rentalCarId}}\",\n  \"startDate\": \"2026-12-01\",\n  \"endDate\": \"2026-12-05\",\n  \"status\": \"RESERVED\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// create a car just for this rental, so running the collection again never double-books",
                  "pm.sendRequest({",
                  "    url: pm.variables.get(\"baseUrl\") + \"/api/cars\",",
                  "    method: \"POST\",",
                  "    header: { \"Content-Type\": \"application/json\" },",
                  "    body: { mode: \"raw\", raw: JSON.stringify({ make: \"Hyundai\", model: \"Kona\", year: 2025, dailyRate: 52.00, status: \"AVAILABLE\" }) }",
                  "}, function (err, res) {",
                  "    pm.collectionVariables.set(\"rentalCarId\", res.json().carId);",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", function () {",
                  "    pm.response.to.have.status(201);",
